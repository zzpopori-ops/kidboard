# ============================================================
#  E2E 테스트 실행 환경
#
#  태그를 버전으로 못박는다. latest 를 쓰면 어느 날 이미지가 바뀌어
#  "어제는 됐는데 오늘은 안 되는" 상황이 생기고, 그때 원인이
#  내 코드인지 이미지인지 구분할 수 없게 된다.
#
#  이미지 버전(v1.56.1)과 package.json 의 @playwright/test 버전은
#  반드시 같아야 한다. 다르면 러너가 이미지에 미리 깔린 브라우저를
#  찾지 못하고 실행 시점에 새로 받으려 든다.
# ============================================================
FROM mcr.microsoft.com/playwright:v1.56.1-noble

WORKDIR /app

# 의존성만 먼저 복사한다. 소스만 고쳤을 때 npm ci 를 건너뛰려고.
COPY package.json package-lock.json ./

# ci 는 package-lock.json 을 그대로 재현한다. install 과 달리 잠금 파일을
# 갱신하지 않으므로, 컨테이너가 호스트와 같은 의존성 트리를 갖는다.
RUN npm ci

COPY . .

# 브라우저는 이미지에 이미 들어 있다(/ms-playwright). 다시 받지 않는다.
CMD ["npm", "test"]
